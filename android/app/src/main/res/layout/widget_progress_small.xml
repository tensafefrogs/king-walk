<?xml version="1.0" encoding="utf-8"?>
<!-- The progress widget, small: the rank and rating (widget_progress_column) on the card -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:padding="@dimen/widget_padding"
    tools:ignore="UselessLeaf,NestedWeights,ContentDescription,UseCompoundDrawables"
    tools:targetApi="31">

    <include layout="@layout/widget_progress_column" />
</FrameLayout>
