<?xml version="1.0" encoding="utf-8"?>
<!-- The daily widget, wide: today's board, and beside it the number, whose turn, the goal and done or waiting -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_bright"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="@dimen/widget_padding"
    tools:ignore="UselessLeaf,NestedWeights,ContentDescription,UseCompoundDrawables"
    tools:targetApi="31">

    <!-- as tall as the widget, as wide as it is tall -->
    <ImageView
        android:id="@+id/board"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include layout="@layout/widget_daily_header" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/daily_number"
            style="@style/WidgetNumber" />

        <TextView
            android:id="@+id/daily_to_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_cream"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/daily_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:textColor="@color/widget_cream_70"
            android:textSize="13sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="8dp" />

        <include layout="@layout/widget_daily_status" />
    </LinearLayout>
</LinearLayout>
