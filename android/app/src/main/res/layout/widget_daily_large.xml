<?xml version="1.0" encoding="utf-8"?>
<!-- The daily widget, large: the number, whose turn and the goal over today's board, done or waiting below it -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_bright"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    tools:ignore="UselessLeaf,NestedWeights,ContentDescription,UseCompoundDrawables"
    tools:targetApi="31">

    <include layout="@layout/widget_daily_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/daily_number"
            style="@style/WidgetNumber" />

        <TextView
            android:id="@+id/daily_to_play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_cream"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/daily_goal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/widget_cream_70"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:scaleType="fitCenter" />

    <include layout="@layout/widget_daily_status" />
</LinearLayout>
