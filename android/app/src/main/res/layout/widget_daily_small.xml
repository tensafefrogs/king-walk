<?xml version="1.0" encoding="utf-8"?>
<!-- The daily widget, small: a 3 x 3 close-up of today's board around its focus square; beside it the number and the
     play button or check; the goal below. No status sentence: in many languages it doesn't fit this size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_bright"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="@dimen/widget_padding"
    tools:ignore="UselessLeaf,NestedWeights,ContentDescription,UseCompoundDrawables"
    tools:targetApi="31">

    <include layout="@layout/widget_daily_header" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/board"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/daily_number"
                style="@style/WidgetNumber"
                android:textSize="24sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/state_done"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/widget_check" />
                <FrameLayout
                    android:id="@+id/state_todo"
                    android:layout_width="38dp"
                    android:layout_height="26dp"
                    android:background="@drawable/widget_button"
                    android:paddingRight="2dp"
                    android:paddingBottom="2dp"
                    tools:ignore="RtlHardcoded,RtlSymmetry">
                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_play" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="6dp" />

    <TextView
        android:id="@+id/daily_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/widget_cream_90"
        android:textSize="12sp" />
</LinearLayout>
