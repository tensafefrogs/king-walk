<?xml version="1.0" encoding="utf-8"?>
<!-- The daily puzzle widget (Widgets.kt, DailyWidget): 2 x 2 with a close-up of today's board, wider or larger with the
     whole board. Drawn again when the game sends new progress and at midnight (updatePeriodMillis 0). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_daily_description"
    android:initialLayout="@layout/widget_daily_plain"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="100dp"
    android:minResizeHeight="100dp"
    android:previewImage="@drawable/widget_preview_daily"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:ignore="UnusedAttribute" />
